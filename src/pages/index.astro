---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { isFuture, isPast } from "date-fns";

import Card from "../components/Card.astro";
import Details from "../components/Details.astro";
import Divider from "../components/Divider.astro";
import EventCardSlots from "../components/EventCardSlots.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";

import "../styles/global.css";

import LogoImage from "../assets/images/lofoten-jazzklubb.png";

const allEvents = (await getCollection("event")).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf(),
);

const pastEvents = allEvents.filter((event) => isPast(event.data.startDate));
const futureEvents = allEvents.filter((event) =>
  isFuture(event.data.startDate),
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="space-y-16 md:space-y-32">
    <div class="w-full bg-blue-900 p-1 md:p-2">
      <div class="w-full bg-blue-700 p-2 md:p-5">
        <div class="w-full bg-blue-500 p-1.5 md:p-3">
          <div class="w-full bg-blue-200 p-1 md:p-2.5">
            <div class="w-full bg-white p-1 md:p-2">
              <Image
                loading="eager"
                src={LogoImage}
                alt={SITE_TITLE}
                class=""
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <section class="space-y-8">
      <h2 class="text-5xl md:text-8xl">Arrangementer</h2>

      {
        futureEvents.length > 0 && (
          <>
            <ul class="grid grid-cols-1 gap-4 md:gap-8">
              <Card
                href={`/arrangement/${futureEvents[0].id}/`}
                title={futureEvents[0].data.title}
                image={futureEvents[0].data.heroImage}
              >
                <EventCardSlots event={futureEvents[0]} />
              </Card>
            </ul>
            {futureEvents.length > 1 && (
              <Divider class="mb-5" variant="big-blue" />
            )}
          </>
        )
      }

      {
        futureEvents.length > 1 && (
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8">
            {futureEvents.slice(1).map((event, index) => (
              <>
                <Card
                  href={`/arrangement/${event.id}/`}
                  title={event.data.title}
                  image={event.data.heroImage}
                >
                  <EventCardSlots event={event} />
                </Card>
                {index !== futureEvents.slice(1).length - 1 && (
                  <Divider class="mb-5 md:hidden" variant="big-blue" />
                )}
              </>
            ))}
          </ul>
        )
      }

      {
        pastEvents.length > 0 && (
          <>
            <Divider class="mt-32 mb-20" variant="big-blue" />
            <Details label="Tidligere arrangementer">
              <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8">
                {pastEvents.map((event, index) => (
                  <>
                    <Card
                      href={`/arrangement/${event.id}/`}
                      title={event.data.title}
                      image={event.data.heroImage}
                    >
                      <EventCardSlots event={event} />
                    </Card>
                    {index !== pastEvents.length - 1 && (
                      <Divider class="mb-5 md:hidden" variant="big-blue" />
                    )}
                  </>
                ))}
              </ul>
            </Details>
          </>
        )
      }
    </section>
  </div>
</Layout>
