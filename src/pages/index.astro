---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { isFuture, isPast } from "date-fns";

import Card from "../components/Card.astro";
import Details from "../components/Details.astro";
import Divider from "../components/Divider.astro";
import Time from "../components/Time.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
import { formatDate, formatWeekdayDateTime } from "../utils/date";

import "../styles/global.css";

import LogoImage from "../assets/images/lofoten-jazzklubb.png";

const allEvents = (await getCollection("event")).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf(),
);

const pastEvents = allEvents.filter((event) => isPast(event.data.startDate));
const futureEvents = allEvents.filter((event) =>
  isFuture(event.data.startDate),
);
const nextEvent = futureEvents[0];
const upcomingEvents = futureEvents.slice(1);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="space-y-16 md:space-y-32">
    <div class="w-full bg-blue-900 p-2">
      <div class="w-full bg-blue-700 p-5">
        <div class="w-full bg-blue-500 p-3">
          <div class="w-full bg-blue-200 p-2.5">
            <div class="w-full bg-white p-2">
              <Image
                loading="eager"
                src={LogoImage}
                alt={SITE_TITLE}
                class=""
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <section class="space-y-8">
      <h2 class="text-5xl md:text-8xl">Arrangementer</h2>

      {
        nextEvent && (
          <>
            <ul class="grid grid-cols-1 gap-4 md:gap-8">
              <Card
                href={`/arrangement/${nextEvent.id}/`}
                title={nextEvent.data.title}
                image={nextEvent.data.heroImage}
              >
                <div slot="meta" class="flex flex-col md:flex-row md:gap-1">
                  <div class="flex items-center justify-start space-x-1 bg-blue-500 px-2 py-2 text-white group-hover:text-white md:bg-transparent md:px-0 md:py-3 md:pr-2 md:group-hover:bg-blue-500">
                    <Icon
                      name="circum:calendar-date"
                      class="-translate-y-0.5"
                      size={32}
                    />
                    <Time
                      date={nextEvent.data.startDate}
                      format={
                        nextEvent.data.endDate
                          ? formatDate
                          : formatWeekdayDateTime
                      }
                      class="first-letter:uppercase"
                    />
                    {nextEvent.data.endDate && (
                      <span>
                        -
                        <Time
                          date={nextEvent.data.endDate}
                          format={formatDate}
                        />
                      </span>
                    )}
                  </div>
                  <div class="flex items-center justify-start space-x-1 bg-blue-400 px-2 py-2 text-white group-hover:text-white md:bg-transparent md:px-2 md:py-3 md:group-hover:bg-blue-400">
                    <Icon
                      name="circum:location-on"
                      size={32}
                      class="-translate-y-0.5"
                    />
                    <span>{nextEvent.data.venue}</span>
                  </div>
                </div>
                <p>{nextEvent.data.description}</p>
              </Card>
            </ul>
            {upcomingEvents.length > 0 && (
              <Divider class="mb-5" variant="big-blue" />
            )}
          </>
        )
      }

      {
        upcomingEvents.length > 0 && (
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8">
            {upcomingEvents.map((event, index) => (
              <>
                <Card
                  href={`/arrangement/${event.id}/`}
                  title={event.data.title}
                  image={event.data.heroImage}
                >
                  <div slot="meta" class="flex flex-col md:flex-row md:gap-1">
                    <div class="flex items-center justify-start space-x-1 bg-blue-500 px-2 py-2 text-white group-hover:text-white md:bg-transparent md:px-0 md:py-3 md:pr-2 md:group-hover:bg-blue-500">
                      <Icon
                        name="circum:calendar-date"
                        class="-translate-y-0.5"
                        size={32}
                      />
                      <Time
                        date={event.data.startDate}
                        format={
                          event.data.endDate
                            ? formatDate
                            : formatWeekdayDateTime
                        }
                        class="leading-16 first-letter:uppercase"
                      />
                      {event.data.endDate && (
                        <span>
                          -
                          <Time date={event.data.endDate} format={formatDate} />
                        </span>
                      )}
                    </div>
                    <div class="flex items-center justify-start space-x-1 bg-blue-400 px-2 py-2 text-white group-hover:text-white md:bg-transparent md:px-2 md:py-3 md:group-hover:bg-blue-400">
                      <Icon
                        name="circum:location-on"
                        size={32}
                        class="-translate-y-0.5"
                      />
                      <span>{event.data.venue}</span>
                    </div>
                  </div>
                  <p>{event.data.description}</p>
                </Card>
                {index !== upcomingEvents.length - 1 && (
                  <Divider class="mb-5 md:hidden" variant="big-blue" />
                )}
              </>
            ))}
          </ul>
        )
      }

      {
        pastEvents.length > 0 && (
          <>
            <Divider class="mt-32 mb-32" variant="big-blue" />
            <Details label="Tidligere arrangementer">
              <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8">
                {pastEvents.map((event, index) => (
                  <>
                    <Card
                      href={`/arrangement/${event.id}/`}
                      title={event.data.title}
                      image={event.data.heroImage}
                    >
                      <div
                        slot="meta"
                        class="flex flex-col md:flex-row md:gap-1"
                      >
                        <div class="flex items-center justify-start space-x-1 bg-blue-500 px-2 py-2 text-white group-hover:text-white md:bg-transparent md:px-0 md:py-3 md:pr-2 md:group-hover:bg-blue-500">
                          <Icon
                            name="circum:calendar-date"
                            class="-translate-y-0.5"
                            size={32}
                          />
                          <Time
                            date={event.data.startDate}
                            format={
                              event.data.endDate
                                ? formatDate
                                : formatWeekdayDateTime
                            }
                            class="first-letter:uppercase"
                          />
                          {event.data.endDate && (
                            <span>
                              -
                              <Time
                                date={event.data.endDate}
                                format={formatDate}
                              />
                            </span>
                          )}
                        </div>
                        <div class="flex items-center justify-start space-x-1 bg-blue-400 px-2 py-2 text-white group-hover:text-white md:bg-transparent md:px-2 md:py-3 md:group-hover:bg-blue-400">
                          <Icon
                            name="circum:location-on"
                            size={32}
                            class="-translate-y-0.5"
                          />
                          <span>{event.data.venue}</span>
                        </div>
                      </div>
                      <p>{event.data.description}</p>
                    </Card>
                    {index !== pastEvents.length - 1 && (
                      <Divider class="mb-5 md:hidden" variant="big-blue" />
                    )}
                  </>
                ))}
              </ul>
            </Details>
          </>
        )
      }
    </section>
  </div>
</Layout>
