---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<details class="group/details">
  <summary
    class="group/summary mb-4 flex w-full cursor-pointer list-none flex-row items-center justify-between gap-2 text-2xl md:w-fit md:justify-start"
  >
    <span
      class="border-b-4 border-transparent group-hover/summary:border-current"
    >
      {label}
    </span>
    <Icon
      class="origin-center -translate-y-0.5 group-open/details:rotate-180 group-hover/summary:scale-110 group-hover/summary:not-group-open/details:rotate-6 group-hover/summary:group-open/details:rotate-174"
      name="stash:chevron-down"
      size={40}
    />
  </summary>
  <slot />
</details>
