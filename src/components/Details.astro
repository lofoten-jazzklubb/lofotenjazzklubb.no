---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<details class="group/details">
  <summary
    class="group/summary mb-4 flex w-fit cursor-pointer list-none flex-row items-center gap-2 px-4 text-2xl md:px-0"
  >
    <span
      class="border-b-4 border-transparent bg-blue-950 group-hover/summary:border-current"
    >
      {label}
    </span>
    <Icon
      class="origin-center -translate-y-0.25 bg-blue-950 group-open/details:rotate-180 group-hover/summary:scale-110 group-hover/summary:not-group-open/details:rotate-6 group-hover/summary:group-open/details:rotate-174"
      name="stash:chevron-down"
      size={36}
    />
  </summary>
  <slot />
</details>
