---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<details class="group/details">
  <summary
    class="group/summary sticky top-12 z-10 mb-4 flex cursor-pointer list-none flex-row items-center gap-2 text-3xl font-medium"
  >
    <span
      class="border-b-4 border-transparent bg-white group-hover/summary:border-current"
    >
      {label}
    </span>
    <Icon
      class="origin-center -translate-y-0.5 bg-white group-open/details:rotate-180 group-hover/summary:scale-110 group-hover/summary:not-group-open/details:rotate-6 group-hover/summary:group-open/details:rotate-174"
      name="stash:chevron-down"
      size={48}
    />
  </summary>
  <slot />
</details>
